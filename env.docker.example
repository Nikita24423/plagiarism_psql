# Скопируйте в `.env` в этой папке перед `docker compose up`:
#   cp env.docker.example .env

ANALYSIS_API_KEY=change-me-in-production
# Обязательно: ключ доступа к Qdrant (в базе — тексты работ студентов).
# Сгенерируйте длинную случайную строку, например: openssl rand -hex 24
QDRANT_API_KEY=change-me-qdrant-key
# auto | cpu | cuda (для Docker с GPU нужен NVIDIA runtime)
DEVICE=auto
# Опционально: число потоков CPU для BLAS/torch на CPU (по умолчанию до 8 или число ядер)
# TORCH_CPU_THREADS=8
# Сколько задач анализа выполняется одновременно; очереди университетов
# (1 университет = 1 очередь) обходятся по кругу
# ANALYSIS_CONCURRENCY=1

# --- Модели и калибровка (дефолты совпадают с кодом; менять не обязательно) ---
# EMBEDDING_MODEL=BAAI/bge-m3
# AI_MODEL=sberbank-ai/rugpt3small_based_on_gpt2
# QDRANT_SCORE_THRESHOLD=0.80
# Порог лексического косинуса гибридного поиска (1.0 — дословная копия чанка)
# LEXICAL_SCORE_THRESHOLD=0.60
# Порог Жаккара смысловых 3-грамм для тира «перефраз» каскада
# PARAPHRASE_THRESHOLD=0.15
# Шаблонные фразы: кусок, похожий на куски из 5+ разных работ, не считается
# заимствованием (если ни одна из них не совпадает по 3+ кускам). 0 — выключить.
# TEMPLATE_MIN_SOURCES=5
# STRONG_SOURCE_MIN_CHUNKS=3
# MATCH_CANDIDATES=20
# AI_ENABLED=true
# Калибровка ИИ: обычные работы ~10–30%, 60%+ — редкость.
# Перепроверять по работам с известным авторством (человек / ИИ).
# AI_DETECT_D0=0.8
# AI_DETECT_SCALE=1.0
# Размер батча детектора ИИ (больше — быстрее, но выше пик памяти)
# AI_DETECT_BATCH_SIZE=8
# Окно детектора ИИ отдельно от поиска заимствований (поиск всегда 500/50)
# AI_CHUNK_SIZE=1000
# AI_CHUNK_OVERLAP=100
# Окна этой длины и короче не оцениваются
# AI_MIN_CHUNK_CHARS=100
# AI_MAX_TOKENS=1500
# mean | median | max | top_share (доля окон с D >= порога)
# AI_AGGREGATION=mean
# Пусто = AI_DETECT_D0. Нужен только для top_share
# AI_TOP_SHARE_THRESHOLD=
# Одна строка на документ в stdout; AI_DEBUG_LOG_CHUNKS — ещё и каждое окно
# (в docker-compose по умолчанию включено, в коде — выключено)
# AI_DEBUG_LOG=true
# AI_DEBUG_LOG_CHUNKS=false
# CORS для браузерных запросов напрямую к API (список origin через запятую)
# CORS_ALLOW_ORIGINS=
